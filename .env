# ------------------------------------------------------------
# User/group IDs — run `id $USER` on your host to get these,
# so the containers write files with your user's permissions
# instead of root.
# ------------------------------------------------------------
PUID=1000
PGID=1000
TZ=America/Detroit

# ------------------------------------------------------------
# NordVPN WireGuard credentials
# ------------------------------------------------------------
# NordVPN doesn't show these in the app — you generate them at:
# https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
# (select "Linux" -> download a WireGuard config for any server,
#  the .conf file contains PrivateKey, Address, and the server's
#  PublicKey + Endpoint)
#
# From that .conf file:
#   [Interface] PrivateKey=...   -> NORDVPN_WG_PRIVATE_KEY
#   [Interface] Address=...      -> NORDVPN_WG_ADDRESS (e.g. 10.5.0.2/32)
#   [Peer] PublicKey=...         -> NORDVPN_WG_PUBLIC_KEY
#   [Peer] Endpoint=IP:PORT      -> NORDVPN_ENDPOINT_IP (just the IP part)
# ------------------------------------------------------------
NORDVPN_WG_PRIVATE_KEY=changeme
NORDVPN_WG_ADDRESS=changeme
NORDVPN_WG_PUBLIC_KEY=changeme
NORDVPN_ENDPOINT_IP=changeme

# ------------------------------------------------------------
# Tailscale
# ------------------------------------------------------------
# Generate a *reusable* auth key at:
# https://login.tailscale.com/admin/settings/keys
# Only used on first run — after that, state lives in
# /data/config/tailscale and the key is ignored.
# ------------------------------------------------------------
TS_AUTHKEY=
